-- Segment products into cost ranges
WITH product_segment AS (
SELECT
	product_key,
	product_name,
	cost,
	CASE WHEN cost < 100 THEN 'Below 100'
		 WHEN cost BETWEEN 100 AND 500 THEN '100 - 500'
		 WHEN cost BETWEEN 500 AND 1000 THEN '500 - 1000'
		 ELSE 'Above 1000'
	END AS cost_range
FROM gold.dim_products)

SELECT
	cost_range,
	COUNT(product_key) AS total_products
FROM product_segment
GROUP BY cost_range

/* Group customers into three segments baased on their spending behavior:
	- VIP: Customers with at least 12 months of history and spending more than 5,000.
	- Regular: Customers with at least 12 months of spending 5,000 or less.
	- New: Customers with a lifespan less than 12 months.
*/

SELECT 
	customer_id,
	first_name,
	last_name,
	CASE WHEN lifespan >= 12 AND total_spending < 5000 THEN 'VIP'
		 WHEN lifespan >= 12 AND total_spending <= 5000 THEN 'Regular'
		 WHEN lifespan < 12 THEN 'New'
	END AS customer_status
FROM
	(SELECT
		customer_id,
		first_name,
		last_name,
		DATEDIFF(MONTH, create_date, GETDATE()) AS lifespan
	FROM gold.dim_customer)t,
	(SELECT
		customer_key,
		SUM(sales_amount) AS total_spending
	FROM gold.fact_sales
	GROUP BY customer_key)t1
